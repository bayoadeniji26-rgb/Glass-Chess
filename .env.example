# Copy this file to .env.local for local development.
# Add the same VITE_FIREBASE_* variables to the Render Static Site build environment.
# These are Firebase web-app configuration values (not Admin SDK private keys).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# EmailJS browser delivery for messages submitted in the Donate dialog.
# Configure the EmailJS template's "To Email" field to your own inbox.
VITE_EMAILJS_SERVICE_ID=service_3l9tc2a
VITE_EMAILJS_TEMPLATE_ID=template_qwi52h9
VITE_EMAILJS_PUBLIC_KEY=aKuTsseHTnwR-RWg
