# Copy this file to .env.local for local development.
# Set the same VITE_* values in Render > Static Site > Environment.
#
# Clerk handles email/password accounts and email verification.
# Copy the publishable key from Clerk Dashboard > API keys.
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase stores private Glass Chess saves. Use the project URL and Publishable key,
# never the Supabase service_role secret in browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# EmailJS browser delivery for messages submitted in the Donate dialog.
# Configure the EmailJS template's "To Email" field to your inbox.
VITE_EMAILJS_SERVICE_ID=service_3l9tc2a
VITE_EMAILJS_TEMPLATE_ID=template_qwi52h9
VITE_EMAILJS_PUBLIC_KEY=aKuTsseHTnwR-RWgG

# Optional secure backend URL for generative King Pawn answers. Never put an AI API key here.
VITE_KING_PAWN_AI_ENDPOINT=
